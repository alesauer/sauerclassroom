# Configurações Gerais
SECRET_KEY=troque_esta_chave_por_uma_chave_fernet_ou_string_segura_local
DATABASE_URL=sqlite:////app/data/academic_hub.db
CREDENTIALS_DIR=/app/credentials

# Google Classroom OAuth 2.0
GOOGLE_CLIENT_SECRETS_FILE=/app/credentials/credentials.json
GOOGLE_TOKEN_FILE=/app/credentials/token.json
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Portal Cotemig (Adapter: mock | httpx | playwright)
COTEMIG_ADAPTER_MODE=mock
COTEMIG_PORTAL_URL=https://portal.cotemig.com.br

# Frontend
VITE_API_URL=http://localhost:8000

